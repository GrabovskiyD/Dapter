<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:Dapter.App.Models"
             xmlns:viewmodel="clr-namespace:Dapter.App.ViewModels"
             x:DataType="viewmodel:MainPageViewModel"
             x:Class="Dapter.App.MainPage">

    <CollectionView ItemsSource="{Binding LifeAspects}">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="model:LifeAspect">
                <VerticalStackLayout>
                    <Label Text="{Binding Name}"/>
                    <Label Text="{Binding Description}"/>
                </VerticalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
